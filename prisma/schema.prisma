generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Group {
  id String @id @default(cuid())
  facebookGroupUrl String
  canonicalGroupUrl String @unique
  facebookGroupId String?
  friendlyName String
  detectedName String?
  location String?
  notes String?
  enabled Boolean @default(true)
  displayOrder Int
  baselineStatus String @default("never_scanned")
  baselineCompletedAt DateTime?
  lastSuccessfulMonitorAt DateTime?
  lastTestedAt DateTime?
  lastTestStatus String?
  lastErrorCode String?
  lastErrorMessage String?
  maxPostsPerRun Int?
  maxScrollActions Int?
  maxGroupDurationSeconds Int?
  posts Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Post {
  id String @id @default(cuid())
  groupId String
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  facebookPostId String?
  canonicalPostUrl String @unique
  authorName String?
  firstCapturedText String?
  latestCapturedText String?
  originalTimestampLabel String?
  originalPostedAt DateTime?
  firstDiscoveredAt DateTime @default(now())
  lastObservedAt DateTime @default(now())
  hasImages Boolean @default(false)
  imageCount Int @default(0)
  ocrStatus String @default("disabled")
  ocrText String?
  analysisStatus String @default("not_analysed")
  reviewStatus String @default("new")
  monitoringStatus String @default("active")
  extractionStrategy String?
  extractionConfidence Float?
  fieldWarnings Json?
  referralMatches ReferralMatch[]
  aiAssessments PostAiAssessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralMember {
  id String @id @default(cuid())
  name String
  businessName String?
  facebookName String?
  facebookProfileUrl String?
  category String
  keywords String
  servicesOffered String?
  idealReferral String?
  negativeKeywords String?
  notes String?
  active Boolean @default(true)
  matches ReferralMatch[]
  aiMemberMatches AiMemberMatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralMatch {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  referralMemberId String
  referralMember ReferralMember @relation(fields: [referralMemberId], references: [id], onDelete: Cascade)
  score Float
  matchedKeywords Json?
  status String @default("suggested")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, referralMemberId])
}
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ScrapeRun {
  id            String    @id @default(cuid())
  groupId       String?
  runType       String
  status        String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  groupsCompleted Int     @default(0)
  postsInspected Int      @default(0)
  newPostsSaved Int       @default(0)
  scrollActions  Int      @default(0)
  warningCount  Int       @default(0)
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ScrapeEvent {
  id              String   @id @default(cuid())
  scrapeRunId     String?
  level           String
  type            String
  message         String
  technicalDetail Json?
  createdAt       DateTime @default(now())
}

model AnalysisJob {
  id               String    @id @default(cuid())
  status           String
  requestedPostIds Json?
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PostAiAssessment {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  status String @default("pending")
  provider String?
  model String?
  inputTokens Int?
  cachedInputTokens Int?
  outputTokens Int?
  totalTokens Int?
  requestCount Int?
  estimatedCostUsd Float?
  durationMs Int?
  pricingSnapshot Json?
  promptVersion String
  promptText String?
  renderedPrompt String?
  inputPayload Json?
  rawResponse Json?
  parsed Json?
  intent String?
  isReferralOpportunity Boolean?
  confidence Float?
  summary String?
  errorMessage String?
  startedAt DateTime?
  completedAt DateTime?
  memberMatches AiMemberMatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([status])
  @@index([promptVersion])
  @@index([provider, model])
  @@index([createdAt])
}

model AiMemberMatch {
  id String @id @default(cuid())
  assessmentId String
  assessment PostAiAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  referralMemberId String
  referralMember ReferralMember @relation(fields: [referralMemberId], references: [id], onDelete: Cascade)
  score Float
  scorePercent String
  reason String?
  suggestedIntro String?
  status String @default("new")
  copiedAt DateTime?
  introducedAt DateTime?
  dismissedAt DateTime?
  note String?
  createdAt DateTime @default(now())

  @@unique([assessmentId, referralMemberId])
  @@index([referralMemberId])
}

model NotificationDelivery {
  id String @id
  postId String
  referralMemberId String
  channel String @default("telegram")
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  claimedAt DateTime?
  sentAt DateTime?
  messageId String?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([postId, referralMemberId, channel])
  @@index([status, availableAt])
}

model VisitorCategory {
  id String @id
  name String
  includeRules String
  excludeRules String
  keywords Json
  area String
  priority String
  reviewFlag String?
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model VisitorBusiness {
  id String @id @default(cuid())
  identityKey String @unique
  name String
  website String?
  phone String?
  status String @default("not contacted")
  reviewNote String?
  evidence VisitorEvidence[]
  identities VisitorIdentity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorEvidence {
  id String @id @default(cuid())
  businessId String
  business VisitorBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  postId String
  categoryId String
  contentHash String
  matchedTerms Json
  geographyEvidence String?
  createdAt DateTime @default(now())
  @@unique([postId, categoryId])
  @@index([businessId])
}

model VisitorExclusion {
  id String @id
  name String
  company String
  reason String
  status String
  active Boolean @default(true)
}

model VisitorIdentity {
  key String @id
  businessId String
  business VisitorBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
